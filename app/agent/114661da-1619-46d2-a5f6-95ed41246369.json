666f\uff0c\u6211\u7acb\u523b\u4e3a\u4f60\u652f\u6301\uff01 \ud83d\udca1", "additional_kwargs": {}, "response_metadata": {}, "type": "ai", "name": null, "id": null, "example": false, "tool_calls": [], "invalid_tool_calls": [], "usage_metadata": null}}]